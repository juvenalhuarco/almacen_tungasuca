# ---------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Origen permitido para CORS en desarrollo (URL del cliente Vite)
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=almacen_tungasuca
DB_LOGGING=false
# En la nube se puede usar la cadena de conexión completa en lugar de las variables DB_*
# (por ejemplo la que entrega Neon o Render). Los proveedores en la nube exigen SSL.
DATABASE_URL=
DB_SSL=false

# ---------------------------------------------------------------
# Autenticación JWT
# ---------------------------------------------------------------
JWT_ACCESS_SECRET=cambiar-por-una-clave-larga-y-aleatoria
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=cambiar-por-otra-clave-larga-y-aleatoria
JWT_REFRESH_EXPIRES=7d
# Duración del refresh token cuando el usuario marca "Recuérdame"
JWT_REFRESH_EXPIRES_REMEMBER=30d

# ---------------------------------------------------------------
# Datos de la empresa (se usan en reportes y PDF membretado)
# ---------------------------------------------------------------
COMPANY_NAME=Consorcio Tungasuca
COMPANY_RUC=
COMPANY_ADDRESS=Cusco - Perú
COMPANY_PHONE=
COMPANY_EMAIL=

# ---------------------------------------------------------------
# Alertas por correo (SMTP). Si SMTP_HOST está vacío, no se envían correos.
# ---------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Almacén Tungasuca <no-reply@tungasuca.pe>"
# Destinatarios separados por coma
ALERT_EMAIL_RECIPIENTS=
# Hora de la revisión diaria de stock mínimo (formato cron)
STOCK_CHECK_CRON=0 7 * * *
